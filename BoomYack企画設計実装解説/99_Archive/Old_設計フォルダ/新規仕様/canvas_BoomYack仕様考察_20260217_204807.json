        "配置物ID": "1af99c6c-6c7f-42b3-8679-6b43e3cb7d2b",
        "接続位置": "右"
      }
    },
    {
      "type": "付箋",
      "id": "2da799b7-6fa6-41b1-89cc-40397c7a7982",
      "position": {
        "x": 8625.760081994384,
        "y": 1627.5943522686107
      },
      "size": {
        "width": 200,
        "height": 72
      },
      "text": "使い方例を考える。"
    },
    {
      "type": "付箋",
      "id": "b0da4674-ddce-4316-8826-c7167d54e649",
      "position": {
        "x": 8625.760081994384,
        "y": 1927.5943522686107
      },
      "size": {
        "width": 200,
        "height": 112
      },
      "text": "1. ローカルフォルダに保存された付箋ファイルをBoomYackで開く\n"
    },
    {
      "type": "付箋",
      "id": "9566a5fe-708b-4adf-85b5-6d35f29b3df2",
